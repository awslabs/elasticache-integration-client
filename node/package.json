{
  "name": "photon-nodejs",
  "version": "0.0.1",
  "description": "TypeScript parity prototype for the Photon Node.js client.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "vendor/developer-toolkit-elasticache-package"
  ],
  "scripts": {
    "generate:idempotency": "node scripts/generate-idempotency.mjs",
    "check:idempotency": "node scripts/generate-idempotency.mjs --check",
    "clean": "node scripts/clean.mjs",
    "build:iam": "node scripts/build-iam.mjs",
    "prebuild": "npm run check:idempotency",
    "build": "npm run clean && npm run build:iam && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run build:iam && tsc -p tsconfig.esm.json --noEmit && tsc -p tsconfig.cjs.json --noEmit",
    "test:idempotency-catalog": "node --test scripts/idempotency-catalog.test.mjs",
    "test": "npm run build:iam && npm run test:idempotency-catalog && vitest run --coverage",
    "pack:smoke": "npm run build && node scripts/package-smoke.mjs",
    "verify": "npm run check:idempotency && npm run format:check && npm run lint && npm run typecheck && npm test && npm run pack:smoke"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@aws-sdk/client-dynamodb": "^3.1141.0",
    "@aws-sdk/nested-clients": "^3.997.41",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "publint": "0.3.24",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@aws-sdk/core": "^3.977.1",
    "@aws-sdk/credential-providers": "^3.1096.0",
    "@aws/developer-toolkit-elasticache": "0.1.0-dev.0",
    "@marcbachmann/cel-js": "^8.0.0",
    "@smithy/core": "^3.31.0",
    "@smithy/hash-node": "^4.2.7",
    "@smithy/signature-v4": "^5.6.11",
    "@smithy/types": "^4.16.1"
  },
  "bundleDependencies": [
    "@aws/developer-toolkit-elasticache"
  ]
}
