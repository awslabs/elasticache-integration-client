{
  "name": "@aws-sdk/aws-elasticache-integration-client",
  "version": "0.0.1",
  "description": "ElastiCache Integrations for AWS SDK for JavaScript v3 DynamoDB clients.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awslabs/elasticache-integration-client.git",
    "directory": "node"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate:idempotency": "node scripts/generate-idempotency.mjs",
    "check:idempotency": "node scripts/generate-idempotency.mjs --check",
    "clean": "node scripts/clean.mjs",
    "prebuild": "npm run check:idempotency",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit && tsc -p tsconfig.cjs.json --noEmit",
    "test:idempotency-catalog": "node --test scripts/idempotency-catalog.test.mjs",
    "test:version-stamp": "node --test scripts/set-package-version.test.mjs",
    "test": "npm run test:idempotency-catalog && npm run test:version-stamp && vitest run --coverage",
    "pack:smoke": "npm run build && node scripts/package-smoke.mjs",
    "example:local-e2e": "npm run build && node examples/local-e2e.mjs",
    "verify": "npm run check:idempotency && npm run format:check && npm run lint && npm run typecheck && npm test && npm run pack:smoke"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@aws-sdk/client-dynamodb": "^3.1141.0",
    "@aws-sdk/nested-clients": "^3.997.41",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@aws-sdk/core": "^3.977.1",
    "@aws-sdk/credential-providers": "^3.1096.0",
    "@aws/developer-toolkit-elasticache": "^1.0.0",
    "@marcbachmann/cel-js": "^8.0.0",
    "@smithy/core": "^3.31.0",
    "@smithy/hash-node": "^4.2.7",
    "@smithy/signature-v4": "^5.6.11",
    "@smithy/types": "^4.16.1"
  }
}
