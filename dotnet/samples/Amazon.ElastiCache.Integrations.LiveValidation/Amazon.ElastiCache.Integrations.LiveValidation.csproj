<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The runner has no .NET: publish with -p:LiveRid=linux-arm64 for a self-contained build. -->
    <RuntimeIdentifiers>linux-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(LiveRid)' != ''">$(LiveRid)</RuntimeIdentifier>
    <SelfContained Condition="'$(LiveRid)' != ''">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Amazon.ElastiCache.Integrations/Amazon.ElastiCache.Integrations.csproj" />
  </ItemGroup>

</Project>
