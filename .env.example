# AWS credentials must be available through the standard SDK credential chain.
# The examples and the README commands use AWS_REGION. The examples default to us-east-1.
AWS_REGION=us-east-1

# ElastiCache Serverless cache used with ElastiCache IAM authentication.
ELASTICACHE_CACHE_NAME=your-cache-name
ELASTICACHE_CACHE_HOST=your-cache-endpoint.serverless.use1.cache.amazonaws.com
ELASTICACHE_CACHE_PORT=6379

# Set this to the local side of an SSH tunnel. Remove it when the cache endpoint
# is directly reachable from the machine running the example.
ELASTICACHE_TUNNEL_HOST=127.0.0.1

# Existing DynamoDB table with a string partition key named "id".
ELASTICACHE_TABLE_NAME=ElastiCacheIntegrationsTestTable

# Each run generates a fresh item ID so the first ElastiCache Integrations read is a cache miss.
# Set this only to pin one ID while reproducing a specific run.
# ELASTICACHE_ITEM_ID=elasticache-integrations-e2e-debug

# Optional when the cache uses a non-default IAM user.
# ELASTICACHE_CACHE_USER_ID=default.iam-user

# Optional for Node/Python when the cache uses a private CA instead of the
# system trust store. Java uses the JVM trust store.
# ELASTICACHE_CA_CERT=/path/to/ca.crt

# Optional. Seconds to wait for each cache reply. Defaults to 5.
# ELASTICACHE_REQUEST_TIMEOUT_SECONDS=5

# Optional. Parallel reads in the concurrent-reads scenario. Defaults to 16.
# ELASTICACHE_CONCURRENCY=16
